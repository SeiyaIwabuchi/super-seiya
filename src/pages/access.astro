---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const businessHours = [
  { day: '月曜日', open: '9:00', close: '20:00', note: '' },
  { day: '火曜日', open: '9:00', close: '20:00', note: '' },
  { day: '水曜日', open: '9:00', close: '20:00', note: '' },
  { day: '木曜日', open: '9:00', close: '20:00', note: '' },
  { day: '金曜日', open: '9:00', close: '20:00', note: '' },
  { day: '土曜日', open: '9:00', close: '20:00', note: '' },
  { day: '日曜日', open: '9:00', close: '20:00', note: '' },
];

// Google Maps埋め込みURL
const mapsEmbedUrl = 'https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d6210.146128989741!2d141.2714275245919!3d38.899444459105496!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sja!2sjp!4v1780144790120!5m2!1sja!2sjp';
---

<BaseLayout
  title="アクセス"
  description="スーパーせい屋へのアクセス情報です。岩手県一関市鹿島町に位置し、無料駐車場完備。営業時間・定休日もご確認ください。"
  path="/access"
>
  <Header />

  <main>
    <!-- ページヘッダー -->
    <section class="bg-[var(--color-accent)] text-white py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p class="text-sm font-medium tracking-widest mb-3 opacity-80">ACCESS</p>
        <h1 class="text-4xl md:text-5xl font-serif font-bold">アクセス</h1>
      </div>
    </section>

    <!-- マップ -->
    <section class="py-12">
      <div class="max-w-5xl mx-auto px-4">
        {mapsEmbedUrl ? (
          <div class="rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-sm aspect-[16/9] md:aspect-[2/1]">
            <iframe
              src={mapsEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="スーパーせい屋 地図"
            ></iframe>
          </div>
        ) : (
          <div class="rounded-2xl border-2 border-dashed border-[var(--color-border)] bg-[var(--color-surface)] aspect-[16/9] md:aspect-[2/1] flex flex-col items-center justify-center gap-4 text-[var(--color-text-muted)]">
            <i class="fa-solid fa-map-location-dot text-5xl text-[var(--color-border)]" aria-hidden="true"></i>
            <p class="text-sm font-medium">地図を表示するには Google Maps の埋め込み URL を設定してください</p>
            <a
              href="https://www.google.com/maps/search/?api=1&query=岩手県一関市"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm bg-[var(--color-accent)] text-white px-5 py-2 rounded-full hover:bg-[var(--color-accent-hover)] transition-colors"
            >
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              Google マップで開く
            </a>
          </div>
        )}
        <p class="text-xs text-[var(--color-text-muted)] mt-2 text-center">
        </p>
      </div>
    </section>

    <!-- 店舗情報 -->
    <section class="pb-12">
      <div class="max-w-3xl mx-auto px-4">
        <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl overflow-hidden">
          <dl class="text-sm divide-y divide-[var(--color-border)]">
            {[
              { term: '住所', desc: '〒029-0365　岩手県一関市鹿島町10−3' },
              { term: '電話番号', desc: '0191-55-2364' },
              { term: '駐車場', desc: '無料駐車場あり（12台）' },
              { term: '最寄り情報', desc: 'JR一ノ関駅より車で約10分 ／ バス停「清平」より徒歩3分' },
            ].map(({ term, desc }) => (
              <div class="flex flex-col sm:flex-row sm:items-start">
                <dt class="sm:w-36 shrink-0 font-bold text-[var(--color-text-muted)] bg-[var(--color-bg)] px-5 py-4 sm:border-r border-[var(--color-border)]">
                  {term}
                </dt>
                <dd class="px-5 py-4 text-[var(--color-text)] leading-relaxed">{desc}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- 営業時間 -->
    <section class="pb-20">
      <div class="max-w-3xl mx-auto px-4">
        <p class="text-sm font-medium text-[var(--color-sub-accent)] tracking-widest mb-2 text-center">OPENING HOURS</p>
        <h2 class="text-3xl font-serif font-bold text-center mb-8 text-[var(--color-text)]">営業時間</h2>

        <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-[var(--color-bg)] border-b border-[var(--color-border)]">
                <th class="text-left px-5 py-3 font-bold text-[var(--color-text-muted)]">曜日</th>
                <th class="text-center px-5 py-3 font-bold text-[var(--color-text-muted)]">開店</th>
                <th class="text-center px-5 py-3 font-bold text-[var(--color-text-muted)]">閉店</th>
                <th class="text-center px-5 py-3 font-bold text-[var(--color-text-muted)]">備考</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--color-border)]">
              {businessHours.map(({ day, open, close, note }) => (
                <tr class="hover:bg-[var(--color-bg)] transition-colors">
                  <td class="px-5 py-3 font-medium text-[var(--color-text)]">{day}</td>
                  <td class="px-5 py-3 text-center text-[var(--color-text)]">{open}</td>
                  <td class="px-5 py-3 text-center text-[var(--color-text)]">{close}</td>
                  <td class="px-5 py-3 text-center text-[var(--color-text-muted)]">{note || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-xs text-[var(--color-text-muted)] mt-4 text-center leading-relaxed">
          年末年始（12月31日〜1月3日）は短縮営業または休業となる場合があります。<br />
          詳しくはお電話（0191-55-2364）にてご確認ください。
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
